# Configuración del proyecto Firebase de PRODUCCIÓN
# (Consola de Firebase → Configuración del proyecto → General → Tus apps).
#
# Solo el entorno de PRODUCCIÓN usa un proyecto de Firebase real. El entorno de DESARROLLO
# usa el Firebase Emulator Suite (docker-compose.dev.yml) y no necesita ningún .env:
# sus valores ya van fijos en ese archivo.
#
#   Producción  → .env en ~/crediflow-prod del droplet (o .env.production en tu PC)
#
# Los valores se incrustan en el bundle al compilar (así funciona cualquier SDK web de Firebase);
# la seguridad de los datos la dan las Firestore Security Rules, no el secreto de estas claves.
# NUNCA subas los .env reales al repositorio (ya están en .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Solo para trabajar en local con `npm run dev` contra el emulador (opcional) ---
# Descomenta y usa: VITE_FIREBASE_PROJECT_ID=demo-crediflow, VITE_FIREBASE_API_KEY=demo-api-key
# VITE_USE_EMULATORS=true
